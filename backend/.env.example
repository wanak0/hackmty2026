# Configuración de Ollama Cloud / Ollama API (docs.ollama.com)
# Para Ollama Cloud: Host https://ollama.com y tu API Key de https://ollama.com/settings/keys
# Para Ollama Local: Host http://localhost:11434 (API Key vacía)
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=tu_clave_de_ollama_cloud_aqui

# NLP / clasificación de intención (modelo ligero)
OLLAMA_MODEL=gemma4:3.1b

# Generación A2UI pura (mismo API key, modelo más capaz)
A2UI_MODEL=gemma4:31b

# Temperatura del generador A2UI (0.5 = equilibrio creatividad/estabilidad)
A2UI_TEMPERATURE=0.5

# Clave de API de Google Gemini (opcional / fallback A2UI)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Puerto del servidor backend
PORT=3001
